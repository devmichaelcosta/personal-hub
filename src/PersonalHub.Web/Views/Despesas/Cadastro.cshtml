@model PersonalHub.Web.Models.ViewModels.CadastroDespesaViewModel
@{
    ViewData["Title"] = "Cadastrar despesa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Cadastrar despesa</h1>

<hr />

<div class="row">
    <div class="col-md-12">
        <form asp-action="Cadastro" id="form-cadastro">
            @if (ViewBag.TemErros)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                </div>
            }

            <partial name="CadastroCampos" model="Model" />

            <div class="form-group">
                <a class="btn btn-warning" asp-action="Index"><i class="fa fa-chevron-left"></i></a>

                <button type="submit" class="btn btn-dark">
                    Salvar <i class="fa fa-save"></i>
                </button>
            </div>
        </form>
    </div>
</div> 

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script type="module" src="~/js/despesa/cadastro.js"></script>
}
